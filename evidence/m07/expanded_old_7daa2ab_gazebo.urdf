  <!-- The Gazebo side of gz_ros2_control: a MODEL plugin that loads a controller manager next to the model and
           hands it the controller parameters. A model plugin and not a world plugin: the library refuses anything else
           ("is not a model. Please make sure that Gazebo ROS 2 Control is attached to a valid model"). A <gazebo> element
           with no reference becomes a plugin of the model when ros_gz_sim converts the URDF to SDF. Filename and class were
           read from the installed Jazzy gz_ros2_control 1.2.20, not from documentation: libgz_ros2_control-system.so
           registers gz_ros2_control::GazeboSimROS2ControlPlugin (libgz_hardware_plugins.so registers GazeboSimSystem).
           The controllers are the same file every profile uses (ADR-003), but this description does not know where it lives:
           the path comes in as the controllers_file arg, and with the arg empty (the default) there is no <parameters> at all.
           The launch that starts the simulation supplies it, so this package does not resolve the control package's path
           (it would be an undeclared dependency, or a cycle: control test-depends on this package). The world, physics,
           sensors and the launch that spawns this model are simulation bringup and live in openamrobot_upperbody_gazebo. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    </plugin>
  </gazebo>
  <ros2_control name="openamr_arms_gazebo" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
