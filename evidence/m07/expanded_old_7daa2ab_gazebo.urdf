    <surface>
      <friction>
        <ode>
          <mu>1.5</mu>
          <mu2>0.5</mu2>
          <fdir1>1 0 0</fdir1>
          <slip1>0.001</slip1>
          <slip2>0.001</slip2>
        </ode>
      </friction>
      <contact>
        <ode>
          <kp>1e7</kp>
          <kd>1</kd>
