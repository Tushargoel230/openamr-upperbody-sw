  <!-- ── Link-level: camera_link — forward-facing RGB camera ──────── -->
  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor name="camera_sensor" type="camera">
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
      <topic>/rgb_image</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <update_rate>12</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>15.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
  <!-- ── Link-level: imu_link — simulated IMU (from #69) ─────────────── -->
  <!-- Publishes gz topic "imu", which config/gz_bridge.yaml bridges to /imu.
       The sensor sits on imu_link with no pose offset; the frame (sensor axes,
       yaw -90 deg) is declared in sensors.xacro. The rate matches the 0.02 s
       nominal period in openamrobot_nav2 navigation_status_profile.yaml. No noise
       model: simulation only, not the ICM-42688-P's characteristics. -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <pose relative_to="imu_link">0 0 0 0 0 0</pose>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
  <!-- The IMU system updates every imu sensor; neither walled_world.sdf nor
       a world that composes this model loads it, so the model does. -->
  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>
  <!-- ── Link-level: lidar_link — sensor ONLY here ─────────────────── -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.40</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
      <always_on>true</always_on>
    </sensor>
  </gazebo>
  <link name="mast_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.6182500000000001"/>
      <mass value="3.0"/>
      <inertia ixx="0.3858330625000001" ixy="0" ixz="0" iyy="0.38313306250000007" iyz="0" izz="0.0045"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.6182500000000001"/>
      <geometry>
        <box size="0.06 0.12 1.2365000000000002"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.6182500000000001"/>
      <geometry>
        <box size="0.06 0.12 1.2365000000000002"/>
      </geometry>
    </collision>
  </link>
  <link name="mast_mount_link"/>
  <joint name="mast_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_base_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.2"/>
  </joint>
