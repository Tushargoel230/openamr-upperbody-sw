<?xml version="1.0"?>
<!--
  OpenAMRobot mast (ADR-006, ADR-008): base_link -> mast_base_link -> mast_mount_link, plus the two arm-plate joints.

  Every number comes from datums.yaml or mast_ids.yaml. The only literals in this file are structural zeros
  (identity rotations, zero off-axis offsets, zero inertia products) and the geometry constants of a solid cuboid
  (1/12 and 1/2).

  mast_mount_link IS the plate reference frame (plate z = 0 by construction), so the whole shoulder height lives in
  mast_offset:
      mast_offset = shoulder_height(mast_id) - base_link_height_above_floor - mast_base_pose.z - left_arm_mount_pose.z
  Nothing here may read an upstream OpenArm *body* reference point: the body is not installed (ADR-008).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- <origin> from a datum pose {xyz: [x, y, z], rpy: [r, p, y]}. -->
  <xacro:macro name="openamr_origin_from_pose" params="pose">
    <origin xyz="${pose['xyz'][0]} ${pose['xyz'][1]} ${pose['xyz'][2]}"
            rpy="${pose['rpy'][0]} ${pose['rpy'][1]} ${pose['rpy'][2]}"/>
  </xacro:macro>

  <!--
    mast_id    key of mast_ids['mast_ids'] (validated by the caller)
    datums     parsed datums.yaml
    mast_ids   parsed mast_ids.yaml
    arm_mounts emit the two arm-plate joints. Only valid when the upstream macro is called afterwards, because the
               plate LINKS (mast_{left,right}_arm_mount_link) are that macro's root_frame and are not declared here.
  -->
  <xacro:macro name="openamr_mast" params="mast_id datums mast_ids arm_mounts:=false">
    <xacro:property name="dt" value="${datums['datums']}"/>
    <xacro:property name="floor_to_base" value="${dt['base_link_height_above_floor']['value']}"/>
    <xacro:property name="mast_base_pose" value="${dt['mast_base_pose']['value']}"/>
    <xacro:property name="shoulder_height" value="${mast_ids['mast_ids'][mast_id]['shoulder_height']}"/>
    <xacro:property name="mast_offset"
                    value="${shoulder_height - floor_to_base - mast_base_pose['xyz'][2] - dt['left_arm_mount_pose']['value']['xyz'][2]}"/>

    <!-- Placeholder box: from the mast foot up to mast_top_height above the floor. -->
    <xacro:property name="section_x" value="${dt['mast_section']['value'][0]}"/>
    <xacro:property name="section_y" value="${dt['mast_section']['value'][1]}"/>
    <xacro:property name="mast_height" value="${mast_ids['mast_top_height'] - floor_to_base - mast_base_pose['xyz'][2]}"/>
    <xacro:property name="mast_m" value="${dt['mast_mass']['value']}"/>

    <link name="mast_base_link">
      <inertial>
        <origin xyz="0 0 ${mast_height / 2}" rpy="0 0 0"/>
        <mass value="${mast_m}"/>
        <inertia ixx="${mast_m * (section_y * section_y + mast_height * mast_height) / 12}" ixy="0" ixz="0"
                 iyy="${mast_m * (section_x * section_x + mast_height * mast_height) / 12}" iyz="0"
                 izz="${mast_m * (section_x * section_x + section_y * section_y) / 12}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${mast_height / 2}" rpy="0 0 0"/>
        <geometry><box size="${section_x} ${section_y} ${mast_height}"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 ${mast_height / 2}" rpy="0 0 0"/>
        <geometry><box size="${section_x} ${section_y} ${mast_height}"/></geometry>
      </collision>
    </link>

    <link name="mast_mount_link"/>

    <joint name="mast_base_joint" type="fixed">
      <parent link="base_link"/>
      <child link="mast_base_link"/>
      <xacro:openamr_origin_from_pose pose="${mast_base_pose}"/>
    </joint>

    <joint name="mast_mount_joint" type="fixed">
      <parent link="mast_base_link"/>
      <child link="mast_mount_link"/>
      <origin xyz="0 0 ${mast_offset}" rpy="0 0 0"/>
    </joint>

    <xacro:if value="${arm_mounts}">
      <!-- Joints only. The child links are declared by the upstream openarm_v20_robot macro (ADR-008). -->
      <joint name="left_arm_mount_joint" type="fixed">
        <parent link="mast_mount_link"/>
        <child link="mast_left_arm_mount_link"/>
        <xacro:openamr_origin_from_pose pose="${dt['left_arm_mount_pose']['value']}"/>
      </joint>
      <joint name="right_arm_mount_joint" type="fixed">
        <parent link="mast_mount_link"/>
        <child link="mast_right_arm_mount_link"/>
        <xacro:openamr_origin_from_pose pose="${dt['right_arm_mount_pose']['value']}"/>
      </joint>
    </xacro:if>
  </xacro:macro>

</robot>
